* { font-family: Inter, "Segoe UI", sans-serif; color:#FFFFFF; font-size:14px; }
QMainWindow,QWidget { background:#0D0D0D; } QLabel#title {font-size:28px;font-weight:800;} QLabel#subtitle {color:#A0A0A0;} .card {background:#141414;border:1px solid #2A2A2A;border-radius:12px;padding:18px;} QPushButton {background:#1A1A1A;border:1px solid #2A2A2A;border-radius:8px;padding:10px 14px;font-weight:700;} QPushButton:hover {border-color:#00A8FF;background:#242424;} QPushButton:pressed {background:#111;} QPushButton#danger {background:#C92121;border-color:#FF2D2D;} QPushButton#success {background:#008F50;border-color:#00FF88;} QLineEdit,QPlainTextEdit,QSpinBox,QTimeEdit {background:#1A1A1A;border:1px solid #2A2A2A;border-radius:7px;padding:9px;} QLineEdit:focus,QPlainTextEdit:focus {border-color:#00A8FF;} QTabBar::tab {background:#141414;padding:12px 20px;border-bottom:2px solid #2A2A2A;} QTabBar::tab:selected {border-bottom-color:#00FF88;} QScrollArea {border:0;} QProgressBar {border:1px solid #2A2A2A;border-radius:5px;text-align:center;} QProgressBar::chunk {background:#00FF88;border-radius:4px;}
